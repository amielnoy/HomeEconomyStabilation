{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-scripts",
    "rootDir": "scripts",
    "strict": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["scripts/*.ts"]
}
