FROM node:24-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.29-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/mazan-habait.html /usr/share/nginx/html/mazan-habait.html
COPY --from=build /workspace/Architecture.html /usr/share/nginx/html/Architecture.html
COPY --from=build /workspace/api-docs.html /usr/share/nginx/html/api-docs.html
COPY --from=build /workspace/scalar-docs.html /usr/share/nginx/html/scalar-docs.html
COPY --from=build /workspace/openapi.json /usr/share/nginx/html/openapi.json
COPY --from=build /workspace/design-system.css /usr/share/nginx/html/design-system.css
COPY --from=build /workspace/resources /usr/share/nginx/html/resources
COPY --from=build /workspace/dist /usr/share/nginx/html/dist

EXPOSE 80

HEALTHCHECK --interval=3s --timeout=2s --retries=20 \
  CMD wget -q -O /dev/null http://127.0.0.1/mazan-habait.html || exit 1
