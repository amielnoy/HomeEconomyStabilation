# Used only by the first-party Vercel API function. A publishable key is low privilege;
# authorization still depends on a verified Supabase Auth JWT and database RLS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Origins this deployment answers on, comma separated and https only. The sign-in callback
# will return the browser only to one of these, or to a path on this site. An open redirect
# here would hand a real session to another page.
AUTH_ALLOWED_ORIGINS=https://home-economy-stabilation.vercel.app

# ---------------------------------------------------------------- open banking --
# שירות מידע פיננסי. Left unset, the feature is off and the API answers
# "open_banking_not_configured" — which is the honest answer, because reading these APIs
# requires a licence as a נותן שירות מידע פיננסי under חוק שירות מידע פיננסי, התשפ"ב-2021
# (supervised by רשות ניירות ערך) plus per-source onboarding with each bank and card
# company. Setting these variables does not grant that licence; it states that one is held.

# The deterministic test registry. Exercises the whole flow — consent, redirect, fetch,
# revoke — against invented accounts that name no real institution. Never set in production.
# OPEN_BANKING_SANDBOX=1

# Your entry in the ISA register. Required alongside the sources below, so that switching
# the real client on is a deliberate act rather than a side effect of adding a URL.
# OPEN_BANKING_LICENCE_ID=

# One source per line: id|kind|name|base_url|authorization_url|token_url
# `kind` is `bank` or `card_issuer`; `base_url` is the source's XS2A base (the Bank of
# Israel's profile of Berlin Group NextGenPSD2). https only — an http line is dropped.
# OPEN_BANKING_SOURCES="examplebank|bank|בנק לדוגמה|https://api.examplebank.co.il/psd2|https://api.examplebank.co.il/oauth/authorize|https://api.examplebank.co.il/oauth/token"

# The client registration each source issued you, kept apart from the display name above so
# a registration never shares a variable with a label. Suffix is the upper-cased source id.
# OPEN_BANKING_CLIENT_ID_EXAMPLEBANK=

# The transport certificate the source will not answer without — the practical form the
# licence takes at the wire. Paths to a PEM certificate and its private key.
# OPEN_BANKING_CLIENT_CERT=
# OPEN_BANKING_CLIENT_KEY=
