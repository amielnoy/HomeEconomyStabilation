# Used only by the first-party Vercel API function. A publishable key is low privilege;
# authorization still depends on a verified Supabase Auth JWT and database RLS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Origins this deployment answers on, comma separated and https only. The sign-in callback
# will return the browser only to one of these, or to a path on this site. An open redirect
# here would hand a real session to another page.
AUTH_ALLOWED_ORIGINS=https://home-economy-stabilation.vercel.app
