FROM node:24-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.docs.json tsconfig.scripts.json ./
COPY src/api-docs.ts src/scalar-docs.ts ./src/
COPY scripts/copy-api-docs-assets.ts scripts/prepare-vercel-output.ts ./scripts/
RUN npm run build:docs \
  && npm run build:scripts \
  && node dist-scripts/copy-api-docs-assets.js

FROM nginx:1.29-alpine

COPY docker/nginx.scalar.conf /etc/nginx/conf.d/default.conf
COPY scalar-docs.html /usr/share/nginx/html/scalar-docs.html
COPY api-docs.html /usr/share/nginx/html/api-docs.html
COPY openapi.json /usr/share/nginx/html/openapi.json
COPY --from=build /workspace/dist/scalar /usr/share/nginx/html/dist/scalar
COPY --from=build /workspace/dist/swagger-ui /usr/share/nginx/html/dist/swagger-ui
COPY --from=build /workspace/dist/api-docs.js /usr/share/nginx/html/dist/api-docs.js
COPY --from=build /workspace/dist/scalar-docs.js /usr/share/nginx/html/dist/scalar-docs.js

EXPOSE 80

HEALTHCHECK --interval=3s --timeout=2s --retries=20 \
  CMD wget -q -O /dev/null http://127.0.0.1/scalar-docs.html || exit 1
