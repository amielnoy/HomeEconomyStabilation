{
  "version": "0.2",
  "language": "en,en-GB",
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "dist-api/**",
    "dist-scripts/**",
    "public/**",
    ".vercel/**",
    "allure-results/**",
    "allure-report/**",
    "playwright-report/**",
    "test-results/**",
    "fonts/**",
    "package-lock.json",
    "uv.lock",
    "*.legacy-backup.html"
  ],
  "patterns": [
    {
      "name": "hebrew",
      "pattern": "/[\\u0590-\\u05FF\\u200E\\u200F]+/g"
    },
    {
      "name": "ethiopic",
      "pattern": "/[\\u1200-\\u137F]+/g"
    }
  ],
  "ignoreRegExpList": [
    "hebrew",
    "ethiopic"
  ],
  "words": [
    "Amazonbot",
    "Applebot",
    "Bingbot",
    "CCBot",
    "Diffbot",
    "Français",
    "GPTBot",
    "Perplexity",
    "amountcell",
    "axisline",
    "boundsheet",
    "boundsheets",
    "budrow",
    "catcell",
    "catrow",
    "catsel",
    "changefreq",
    "chartwrap",
    "csize",
    "ddmm",
    "difat",
    "eocd",
    "externalagent",
    "gridline",
    "habait",
    "iban",
    "ifmt",
    "isracard",
    "ixfe",
    "labelsst",
    "lastmod",
    "llms",
    "lookarounds",
    "mazan",
    "mchip",
    "monthbar",
    "mulrk",
    "nums",
    "omgili",
    "redoc",
    "refcell",
    "rels",
    "rulerow",
    "sheetread",
    "supabase",
    "svgns",
    "tblwrap",
    "topbar",
    "urlset",
    "vdate",
    "vercel",
    "xmldec",
    "ymdhs"
  ]
}
